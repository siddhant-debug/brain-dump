# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to git.

# Gemini API — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://user:password@localhost/dbname

# JWT signing secret — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-64-char-hex-string-here
