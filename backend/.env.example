# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to git.

# Gemini API — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: switch the LLM provider for local dev/testing. Default: gemini.
# Set to "ollama" to run chat/generation against a local Ollama model instead
# (e.g. over an SSH tunnel to a remote Ollama instance). Not used in prod.
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://user:password@localhost/dbname

# JWT signing secret — generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-64-char-hex-string-here
